rules_version = '2';

// Takeout archives are uploaded from the phone, parsed by a Cloud Function,
// then deleted. A user may only ever write into their own folder, and may
// never read anything back out.
service firebase.storage {
  match /b/{bucket}/o {
    match /takeout/{uid}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 512 * 1024 * 1024
                   && request.resource.contentType.matches('application/(zip|x-zip-compressed|octet-stream)');

      // Nothing reads these back — the function uses the Admin SDK.
      allow read: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
